{
  "name": "@goodapp/observability",
  "version": "0.5.0",
  "private": false,
  "license": "MIT",
  "description": "Shared structured logger, Sentry init, env-validation engine, and health-check helper for GoodApp products.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthiasvienne-boop/goodapp-observability.git"
  },
  "homepage": "https://github.com/matthiasvienne-boop/goodapp-observability#readme",
  "bugs": {
    "url": "https://github.com/matthiasvienne-boop/goodapp-observability/issues"
  },
  "type": "commonjs",
  "exports": {
    "./server": {
      "types": "./dist/cjs/server/index.d.ts",
      "require": "./dist/cjs/server/index.js",
      "import": "./dist/esm/server/index.js"
    },
    "./client": {
      "types": "./dist/esm/client/index.d.ts",
      "import": "./dist/esm/client/index.js",
      "require": "./dist/cjs/client/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/cjs/server/index.d.ts"
      ],
      "client": [
        "dist/esm/client/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:pkgs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkgs": "node scripts/write-dist-package-json.js",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@sentry/node": ">=8",
    "@sentry/react": ">=8",
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "@sentry/node": {
      "optional": true
    },
    "@sentry/react": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/node": "^10.59.0",
    "@sentry/react": "^10.59.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "express": "^4.18.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
